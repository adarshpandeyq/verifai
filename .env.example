# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional live web search. If unset, VERIFAI uses Wikipedia (when reachable)
# and a clearly labelled local demonstration corpus.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional LLM refinement of the already-computed verdict. Never invents URLs.
MODEL_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Set to false to skip Wikipedia live lookup.
WIKIPEDIA_ENABLED=true
